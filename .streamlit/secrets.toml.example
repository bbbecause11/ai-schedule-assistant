# ===========================================================================
# Streamlit 本地密钥配置示例
# ---------------------------------------------------------------------------
# 用法：
#   1. 把本文件复制为同目录下的 secrets.toml（去掉 .example 后缀）
#   2. 填入你自己的密钥
#   3. 重新运行 streamlit run app.py
#
# 注意：secrets.toml 已被 .gitignore 忽略，不会被提交到仓库。
#       本文件只是模板，不含任何真实密钥。
#
# 这个文件的优先级低于系统环境变量：若环境变量已配置，以环境变量为准。
# 不配置也能正常使用，程序会自动降级为本地规则引擎。
# ===========================================================================

# 必填：大模型 API Key
AI_API_KEY = "sk-在此填入你的密钥"

# 可选：接口地址（需包含 /v1 或 /v4 等版本路径）
AI_BASE_URL = "https://api.deepseek.com/v1"

# 可选：模型名称
AI_MODEL = "deepseek-chat"

# 可选：单次请求超时秒数
AI_TIMEOUT = 60
